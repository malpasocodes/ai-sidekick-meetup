# Copy this file to .env and fill in the values. .env is never committed.
# What each variable means is in STACK.md ("Variables"). The production
# connection string goes in a second file: see remote.env.example.

# Connection string of the Neon "dev" branch.
DATABASE_URL=

# Clerk development instance.
PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk user IDs allowed in, separated by commas. The first is the owner.
ALLOWED_CLERK_USER_IDS=

# Mistral key.
AI_API_KEY=
# Leave out for 20.
AI_DAILY_GENERATION_LIMIT=20
