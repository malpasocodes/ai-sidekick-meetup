# The variables AI Sidekick needs, without values. What each one means is in
# STACK.md ("Variables"). Real values live in two files that are never
# committed: .env and remote.env.

# ---- .env ----------------------------------------------------------------
# Connection string of the Neon "dev" branch.
DATABASE_URL=

# Clerk development instance.
PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk user IDs allowed in, separated by commas. The first is the owner.
ALLOWED_CLERK_USER_IDS=

# Mistral key.
AI_API_KEY=
# Leave out for 20.
AI_DAILY_GENERATION_LIMIT=20

# ---- remote.env ----------------------------------------------------------
# Scripts only: the Neon "production" branch.
# PRODUCTION_DATABASE_URL=
